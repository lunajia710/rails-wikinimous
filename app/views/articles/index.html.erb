<h1>Wikinimous</h1>

<ul class = "navbar-nav ml-auto">
    <li>
    <%= link_to "New Article" ,new_article_path, class: "btn btn-primary mb-4" %>
    </li>
</ul>

<div class="container mt-3">
  <div class="row">
    <% @articles.each do |article| %>
    <div class="sol-sm-8">
      <article class="mb-3">
        <h2 class="card-title">
          <%= link_to article.title, article_path(article)%>
        </h2>
        <p class="card-text">
          <%= article.content %>
        </p>
      </article>
    </div>
  <% end %>
  </div>

</div>
