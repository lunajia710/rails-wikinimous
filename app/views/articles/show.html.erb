<div class="container mt-3">
  <div class="row">
    <div class="col-sm-8">
      <article>
        <h1><%= @article.title %></h1>
        <p><%= @article.content %></p>
      </article>
        <%= link_to "edit",
        edit_article_path,
        class: "btn btn-primary mb-4"
        %>
        <%= link_to "back to home", articles_path, class: "btn btn-primary mb-4"
        %>
        <%= link_to "delete",
        article_path(@article),
        data: {turbo_method: :delete, turbo_confirm: "Are you sure?"},
        class: "btn btn-primary mb-4"
        %>
    </div>
  </div>
</div>
